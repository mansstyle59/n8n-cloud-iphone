# Copy this file to .env. Never commit .env or put secrets in GitHub.
TZ=Europe/Paris
GENERIC_TIMEZONE=Europe/Paris

# Generate a unique long random value locally and keep it private.
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Local-only defaults. For a public HTTPS URL, set all three values accordingly.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Optional: only needed when using the Cloudflare Tunnel profile.
# Create a Tunnel and route its hostname to http://n8n:5678 first.
TUNNEL_TOKEN=REPLACE_ONLY_IF_USING_CLOUDFLARE_TUNNEL
